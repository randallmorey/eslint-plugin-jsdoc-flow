{
  "name": "eslint-plugin-jsdoc-flow",
  "version": "0.5.0",
  "description": "ESLint rules that flow JSDoc text: consistent sentence spacing, line breaks that never strand a word, and aligned tag descriptions. Autofixable.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/randallmorey/eslint-plugin-jsdoc-flow.git"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "jsdoc",
    "comments",
    "reflow",
    "formatting"
  ],
  "license": "MIT",
  "author": "Randall Morey",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "CHANGELOG.md"
  ],
  "scripts": {
    "corpus:update": "node --import ./tests/setup.js tests/corpus.js --update",
    "lint": "eslint . && prettier . --check && tsc -p tsconfig.json && npm run lint:types && npm run lint:package",
    "lint:fix": "eslint . --fix && prettier . --write",
    "lint:package": "publint --strict && attw --pack --profile esm-only",
    "lint:types": "tsc -p tests/types/tsconfig.nodenext.json && tsc -p tests/types/tsconfig.bundler.json",
    "test": "node --import ./tests/setup.js --test --test-reporter=./tests/reporter.js",
    "test:corpus": "node --import ./tests/setup.js --test --test-reporter=./tests/reporter.js tests/corpus.js",
    "test:coverage": "node --import ./tests/setup.js --test --experimental-test-coverage --test-coverage-include=lib/** --test-coverage-lines=99.8 --test-coverage-branches=99.3 --test-coverage-functions=98.9 --test-reporter=./tests/reporter.js",
    "test:fuzz": "node --import ./tests/setup.js --test --test-reporter=./tests/reporter.js tests/properties.test.js",
    "types": "node scripts/types.js"
  },
  "peerDependencies": {
    "eslint": "^9.15.0 || ^10.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-n": "^17.24.0",
    "fast-check": "^4.10.2",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.25",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "engines": {
    "node": ">= 20.19.0"
  }
}
